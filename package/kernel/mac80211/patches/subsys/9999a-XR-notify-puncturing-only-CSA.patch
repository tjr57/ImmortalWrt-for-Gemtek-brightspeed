Subject: [PATCH] mac80211: notify link changes on puncturing-only CSA

--- a/net/mac80211/chan.c
+++ b/net/mac80211/chan.c
@@ -1674,7 +1674,8 @@
 	if (WARN_ON(!chanreq))
 		return -EINVAL;
 
-	if (link_conf->chanreq.oper.width != link->reserved.oper.width)
+	if (link_conf->chanreq.oper.width != link->reserved.oper.width ||
+	    link_conf->chanreq.oper.punctured != link->reserved.oper.punctured)
 		changed = BSS_CHANGED_BANDWIDTH;
 
 	ieee80211_link_update_chanreq(link, &link->reserved);
@@ -2052,7 +2053,8 @@
 
 			link->radar_required = iter.radar_required;
 
-			if (link_conf->chanreq.oper.width != iter.chanreq->oper.width)
+			if (link_conf->chanreq.oper.width != iter.chanreq->oper.width ||
+			    link_conf->chanreq.oper.punctured != iter.chanreq->oper.punctured)
 				changed = BSS_CHANGED_BANDWIDTH;
 
 			ieee80211_link_update_chanreq(link, &link->reserved);
