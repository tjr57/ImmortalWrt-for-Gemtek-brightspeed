+/* xr_ppe_l2: the single owner of PPE bridge templates (owner decision
+ * 2026-10-11; TC is software policy and latches L2 binding off).
+ *
+ * PUBLISH validates against the live bridge under the same generation fence
+ * as packet commits: the caller names the generation its plan was computed
+ * at, the template is admitted only if that generation is still current at
+ * commit, and any later bridge/netdevice writer revokes it again. Revoked
+ * entries stay owned (cached=0) until REVOKE, so DUMP shows what the kernel
+ * actually holds. DUMP sets NLM_F_DUMP_INTR when the generation or owner set
+ * changes between parts; collectors retry. Templates are inert while the
+ * boot-only bind permissions are off. All commands need CAP_NET_ADMIN.
+ */
+enum {
+	XR_PPE_L2_CMD_UNSPEC,
+	XR_PPE_L2_CMD_GET_STATE,
+	XR_PPE_L2_CMD_PUBLISH,
+	XR_PPE_L2_CMD_REVOKE,
+	XR_PPE_L2_CMD_DUMP,
+};
+
+enum {
+	XR_PPE_L2_A_UNSPEC,
+	XR_PPE_L2_A_PAD,
+	XR_PPE_L2_A_GENERATION,		/* u64 */
+	XR_PPE_L2_A_WRITERS,		/* u32 */
+	XR_PPE_L2_A_NF_LATCHED,		/* u8 */
+	XR_PPE_L2_A_NETDEV_LATCHED,	/* u8 */
+	XR_PPE_L2_A_BIND_ENABLED,	/* u8 */
+	XR_PPE_L2_A_BRIDGE_BIND_ENABLED,	/* u8 */
+	XR_PPE_L2_A_ENTRIES,		/* u32 */
+	XR_PPE_L2_A_COOKIE,		/* u64, owner-chosen */
+	XR_PPE_L2_A_IN_IFINDEX,		/* u32 */
+	XR_PPE_L2_A_OUT_IFINDEX,	/* u32 */
+	XR_PPE_L2_A_VID,		/* u16, 0 on a nonfiltering bridge */
+	XR_PPE_L2_A_IN_TAGGED,		/* u8 */
+	XR_PPE_L2_A_SRC,		/* ETH_ALEN */
+	XR_PPE_L2_A_DST,		/* ETH_ALEN */
+	XR_PPE_L2_A_PUB_GENERATION,	/* u64 */
+	XR_PPE_L2_A_CACHED,		/* u8 */
+	XR_PPE_L2_A_SUBFLOWS,		/* u32 */
+	XR_PPE_L2_A_EGRESS_TAGGED,	/* u8 */
+	__XR_PPE_L2_A_MAX,
+};
+#define XR_PPE_L2_A_MAX (__XR_PPE_L2_A_MAX - 1)
+#define XR_PPE_L2_MAX_ENTRIES 1024
+
+struct airoha_xr_pub {
+	struct list_head node;
+	u64 cookie;
+	struct airoha_flow_table_entry *e;
+};
+
+static struct airoha_ppe *xr_pub_ppe;
+static u32 xr_pub_seq;
+static struct genl_family airoha_xr_family;
+
+static const struct nla_policy airoha_xr_policy[XR_PPE_L2_A_MAX + 1] = {
+	[XR_PPE_L2_A_GENERATION] = { .type = NLA_U64 },
+	[XR_PPE_L2_A_COOKIE] = { .type = NLA_U64 },
+	[XR_PPE_L2_A_IN_IFINDEX] = NLA_POLICY_MIN(NLA_U32, 1),
+	[XR_PPE_L2_A_OUT_IFINDEX] = NLA_POLICY_MIN(NLA_U32, 1),
+	[XR_PPE_L2_A_VID] = NLA_POLICY_MAX(NLA_U16, VLAN_VID_MASK - 1),
+	[XR_PPE_L2_A_IN_TAGGED] = NLA_POLICY_MAX(NLA_U8, 1),
+	[XR_PPE_L2_A_SRC] = NLA_POLICY_ETH_ADDR,
+	[XR_PPE_L2_A_DST] = NLA_POLICY_ETH_ADDR,
+};
+
+static struct airoha_xr_pub *airoha_xr_find(struct airoha_ppe *ppe, u64 cookie)
+{
+	struct airoha_xr_pub *pub;
+
+	list_for_each_entry(pub, &ppe->xr_pub_entries, node)
+		if (pub->cookie == cookie)
+			return pub;
+	return NULL;
+}
+
+static int airoha_xr_put_state(struct sk_buff *skb, struct airoha_ppe *ppe)
+{
+	bool nf, netdev;
+	u32 writers;
+	u64 gen;
+
+	spin_lock_bh(&ppe_lock);
+	gen = ppe->l2_generation;
+	writers = ppe->l2_bridge_writers;
+	nf = ppe->l2_policy_latched;
+	netdev = ppe->l2_netdev_policy_latched;
+	spin_unlock_bh(&ppe_lock);
+
+	if (nla_put_u64_64bit(skb, XR_PPE_L2_A_GENERATION, gen, XR_PPE_L2_A_PAD) ||
+	    nla_put_u32(skb, XR_PPE_L2_A_WRITERS, writers) ||
+	    nla_put_u8(skb, XR_PPE_L2_A_NF_LATCHED, nf) ||
+	    nla_put_u8(skb, XR_PPE_L2_A_NETDEV_LATCHED, netdev) ||
+	    nla_put_u8(skb, XR_PPE_L2_A_BIND_ENABLED, ppe_bind_enable) ||
+	    nla_put_u8(skb, XR_PPE_L2_A_BRIDGE_BIND_ENABLED,
+		       ppe_bridge_bind_enable) ||
+	    nla_put_u32(skb, XR_PPE_L2_A_ENTRIES, ppe->xr_pub_count))
+		return -EMSGSIZE;
+	return 0;
+}
+
+static int airoha_xr_reply_state(struct genl_info *info, u8 cmd, u64 cookie,
+				 bool with_cookie)
+{
+	struct sk_buff *msg;
+	void *hdr;
+
+	msg = genlmsg_new(NLMSG_DEFAULT_SIZE, GFP_KERNEL);
+	if (!msg)
+		return -ENOMEM;
+	hdr = genlmsg_put_reply(msg, info, &airoha_xr_family, 0, cmd);
+	if (!hdr ||
+	    airoha_xr_put_state(msg, xr_pub_ppe) ||
+	    (with_cookie && nla_put_u64_64bit(msg, XR_PPE_L2_A_COOKIE, cookie,
+					      XR_PPE_L2_A_PAD))) {
+		nlmsg_free(msg);
+		return -EMSGSIZE;
+	}
+	genlmsg_end(msg, hdr);
+	return genlmsg_reply(msg, info);
+}
+
+static int airoha_xr_get_state(struct sk_buff *skb, struct genl_info *info)
+{
+	return airoha_xr_reply_state(info, XR_PPE_L2_CMD_GET_STATE, 0, false);
+}
+
+static int airoha_xr_publish(struct sk_buff *skb, struct genl_info *info)
+{
+	struct airoha_ppe *ppe = xr_pub_ppe;
+	struct net_device *indev, *odev = NULL;
+	struct airoha_flow_table_entry *e;
+	struct airoha_gdm_dev *egress_dev;
+	struct airoha_flow_data data = {};
+	struct airoha_l2_flow_key key;
+	struct airoha_foe_entry hwe;
+	struct airoha_xr_pub *pub;
+	u64 cookie, gen;
+	bool tagged, ok;
+	u16 vid;
+	int err;
+
+	if (GENL_REQ_ATTR_CHECK(info, XR_PPE_L2_A_COOKIE) ||
+	    GENL_REQ_ATTR_CHECK(info, XR_PPE_L2_A_GENERATION) ||
+	    GENL_REQ_ATTR_CHECK(info, XR_PPE_L2_A_IN_IFINDEX) ||
+	    GENL_REQ_ATTR_CHECK(info, XR_PPE_L2_A_OUT_IFINDEX) ||
+	    GENL_REQ_ATTR_CHECK(info, XR_PPE_L2_A_VID) ||
+	    GENL_REQ_ATTR_CHECK(info, XR_PPE_L2_A_IN_TAGGED) ||
+	    GENL_REQ_ATTR_CHECK(info, XR_PPE_L2_A_SRC) ||
+	    GENL_REQ_ATTR_CHECK(info, XR_PPE_L2_A_DST))
+		return -EINVAL;
+	cookie = nla_get_u64(info->attrs[XR_PPE_L2_A_COOKIE]);
+	if (airoha_xr_find(ppe, cookie)) {
+		NL_SET_ERR_MSG(info->extack, "cookie already owns a template; revoke it first");
+		return -EEXIST;
+	}
+	if (ppe->xr_pub_count >= XR_PPE_L2_MAX_ENTRIES)
+		return -ENOSPC;
+	tagged = nla_get_u8(info->attrs[XR_PPE_L2_A_IN_TAGGED]);
+	vid = nla_get_u16(info->attrs[XR_PPE_L2_A_VID]);
+
+	if (!airoha_ppe_l2_snapshot(ppe, &gen)) {
+		NL_SET_ERR_MSG(info->extack, "L2 binding is latched off or a bridge writer is active");
+		return -EBUSY;
+	}
+	if (gen != nla_get_u64(info->attrs[XR_PPE_L2_A_GENERATION])) {
+		NL_SET_ERR_MSG(info->extack, "stale generation; re-collect and re-plan");
+		return -ESTALE;
+	}
+
+	/* br_port_get_stp_state() asserts RTNL; genl_lock -> RTNL is the usual
+	 * order for generic netlink handlers.
+	 */
+	rtnl_lock();
+	rcu_read_lock();
+	indev = dev_get_by_index_rcu(&init_net,
+			nla_get_u32(info->attrs[XR_PPE_L2_A_IN_IFINDEX]));
+	odev = dev_get_by_index_rcu(&init_net,
+			nla_get_u32(info->attrs[XR_PPE_L2_A_OUT_IFINDEX]));
+	ok = airoha_ppe_l2_validate(indev, odev, tagged, vid,
+				    nla_data(info->attrs[XR_PPE_L2_A_SRC]),
+				    nla_data(info->attrs[XR_PPE_L2_A_DST]),
+				    &data, &key);
+	if (ok)
+		dev_hold(odev);
+	rcu_read_unlock();
+	rtnl_unlock();
+	if (!ok) {
+		NL_SET_ERR_MSG(info->extack, "live bridge context does not admit this template");
+		return -EINVAL;
+	}
+
+	err = airoha_ppe_foe_entry_prepare(ppe->eth, &hwe, odev,
+					   PPE_PKT_TYPE_BRIDGE, &data, 0, 0,
+					   &egress_dev);
+	dev_put(odev);
+	if (err) {
+		NL_SET_ERR_MSG(info->extack, "egress cannot be represented by a PPE bridge entry");
+		return err;
+	}
+
+	e = kzalloc(sizeof(*e), GFP_KERNEL);
+	pub = kzalloc(sizeof(*pub), GFP_KERNEL);
+	if (!e || !pub) {
+		kfree(e);
+		kfree(pub);
+		return -ENOMEM;
+	}
+	INIT_LIST_HEAD(&e->gc_node);
+	e->l2_key = key;
+	e->l2_generation = gen;
+	e->egress_dev = egress_dev;
+	memcpy(&e->data, &hwe, sizeof(e->data));
+
+	/* Admits only if no writer/latch happened since the snapshot. */
+	err = airoha_ppe_foe_l2_flow_commit_entry(ppe, e);
+	if (err) {
+		kfree(e);
+		kfree(pub);
+		if (err == -EOPNOTSUPP) {
+			NL_SET_ERR_MSG(info->extack, "bridge state changed during publication; retry");
+			return -EAGAIN;
+		}
+		if (err == -EEXIST)
+			NL_SET_ERR_MSG(info->extack, "an identical template key is already published");
+		return err;
+	}
+	pub->cookie = cookie;
+	pub->e = e;
+	list_add_tail(&pub->node, &ppe->xr_pub_entries);
+	ppe->xr_pub_count++;
+	xr_pub_seq++;
+	return airoha_xr_reply_state(info, XR_PPE_L2_CMD_PUBLISH, cookie, true);
+}
+
+static void airoha_xr_release(struct airoha_ppe *ppe, struct airoha_xr_pub *pub)
+{
+	spin_lock_bh(&ppe_lock);
+	/* Removes the cached template, if still cached, and its subflows. */
+	airoha_ppe_foe_remove_l2_flow(ppe, pub->e);
+	spin_unlock_bh(&ppe_lock);
+	list_del(&pub->node);
+	ppe->xr_pub_count--;
+	xr_pub_seq++;
+	kfree(pub->e);
+	kfree(pub);
+}
+
+static int airoha_xr_revoke(struct sk_buff *skb, struct genl_info *info)
+{
+	struct airoha_ppe *ppe = xr_pub_ppe;
+	struct airoha_xr_pub *pub;
+	u64 cookie;
+
+	if (GENL_REQ_ATTR_CHECK(info, XR_PPE_L2_A_COOKIE))
+		return -EINVAL;
+	cookie = nla_get_u64(info->attrs[XR_PPE_L2_A_COOKIE]);
+	pub = airoha_xr_find(ppe, cookie);
+	if (!pub)
+		return -ENOENT;
+	airoha_xr_release(ppe, pub);
+	return airoha_xr_reply_state(info, XR_PPE_L2_CMD_REVOKE, cookie, true);
+}
+
+static int airoha_xr_fill_entry(struct sk_buff *skb, struct airoha_xr_pub *pub,
+				u64 gen)
+{
+	struct airoha_flow_table_entry *e = pub->e, *f;
+	const struct airoha_l2_flow_key *k = &e->l2_key;
+	u32 subflows = 0;
+
+	lockdep_assert_held(&ppe_lock);
+	if (e->l2_cached)
+		hlist_for_each_entry(f, &e->l2_flows, l2_subflow_node)
+			subflows++;
+	if (nla_put_u64_64bit(skb, XR_PPE_L2_A_COOKIE, pub->cookie, XR_PPE_L2_A_PAD) ||
+	    nla_put_u64_64bit(skb, XR_PPE_L2_A_GENERATION, gen, XR_PPE_L2_A_PAD) ||
+	    nla_put_u64_64bit(skb, XR_PPE_L2_A_PUB_GENERATION, e->l2_generation,
+			      XR_PPE_L2_A_PAD) ||
+	    nla_put_u32(skb, XR_PPE_L2_A_IN_IFINDEX, k->ingress_ifindex) ||
+	    nla_put_u16(skb, XR_PPE_L2_A_VID, k->vid) ||
+	    nla_put_u8(skb, XR_PPE_L2_A_IN_TAGGED, !!k->ingress_tagged) ||
+	    nla_put(skb, XR_PPE_L2_A_SRC, ETH_ALEN, k->source) ||
+	    nla_put(skb, XR_PPE_L2_A_DST, ETH_ALEN, k->dest) ||
+	    nla_put_u8(skb, XR_PPE_L2_A_CACHED, e->l2_cached) ||
+	    nla_put_u32(skb, XR_PPE_L2_A_SUBFLOWS, subflows) ||
+	    nla_put_u8(skb, XR_PPE_L2_A_EGRESS_TAGGED,
+		       FIELD_GET(AIROHA_FOE_IB1_BIND_VLAN_LAYER, e->data.ib1) != 0))
+		return -EMSGSIZE;
+	return 0;
+}
+
+static int airoha_xr_dump(struct sk_buff *skb, struct netlink_callback *cb)
+{
+	struct airoha_ppe *ppe = xr_pub_ppe;
+	struct airoha_xr_pub *pub;
+	long idx = 0, start = cb->args[0];
+	u64 gen;
+	void *hdr;
+
+	spin_lock_bh(&ppe_lock);
+	gen = ppe->l2_generation;
+	/* Changes of either the generation or the owner set mark the dump. */
+	cb->seq = (u32)gen + xr_pub_seq;
+	list_for_each_entry(pub, &ppe->xr_pub_entries, node) {
+		if (idx < start) {
+			idx++;
+			continue;
+		}
+		hdr = genlmsg_put(skb, NETLINK_CB(cb->skb).portid,
+				  cb->nlh->nlmsg_seq, &airoha_xr_family,
+				  NLM_F_MULTI, XR_PPE_L2_CMD_DUMP);
+		if (!hdr)
+			break;
+		genl_dump_check_consistent(cb, hdr);
+		if (airoha_xr_fill_entry(skb, pub, gen)) {
+			genlmsg_cancel(skb, hdr);
+			break;
+		}
+		genlmsg_end(skb, hdr);
+		idx++;
+	}
+	spin_unlock_bh(&ppe_lock);
+	cb->args[0] = idx;
+	return skb->len;
+}
+
+static const struct genl_small_ops airoha_xr_ops[] = {
+	{
+		.cmd = XR_PPE_L2_CMD_GET_STATE,
+		.doit = airoha_xr_get_state,
+		.flags = GENL_ADMIN_PERM,
+	}, {
+		.cmd = XR_PPE_L2_CMD_PUBLISH,
+		.doit = airoha_xr_publish,
+		.flags = GENL_ADMIN_PERM,
+	}, {
+		.cmd = XR_PPE_L2_CMD_REVOKE,
+		.doit = airoha_xr_revoke,
+		.flags = GENL_ADMIN_PERM,
+	}, {
+		.cmd = XR_PPE_L2_CMD_DUMP,
+		.dumpit = airoha_xr_dump,
+		.flags = GENL_ADMIN_PERM,
+	},
+};
+
+/* Not __ro_after_init: a built-in driver may probe after init memory is
+ * sealed, and registration writes the family id.
+ */
+static struct genl_family airoha_xr_family = {
+	.name = "xr_ppe_l2",
+	.version = 1,
+	.maxattr = XR_PPE_L2_A_MAX,
+	.policy = airoha_xr_policy,
+	.module = THIS_MODULE,
+	.small_ops = airoha_xr_ops,
+	.n_small_ops = ARRAY_SIZE(airoha_xr_ops),
+	.resv_start_op = XR_PPE_L2_CMD_DUMP + 1,
+};
+
+static void airoha_xr_publisher_init(struct airoha_ppe *ppe)
+{
+	int err;
+
+	INIT_LIST_HEAD(&ppe->xr_pub_entries);
+	if (xr_pub_ppe)
+		return;
+	xr_pub_ppe = ppe;
+	err = genl_register_family(&airoha_xr_family);
+	if (err) {
+		xr_pub_ppe = NULL;
+		dev_warn(ppe->eth->dev, "xr_ppe_l2 publisher unavailable: %d\n", err);
+	}
+}
+
+/* Unregistering waits for running operations; then release owner entries. */
+static void airoha_xr_publisher_deinit(struct airoha_ppe *ppe)
+{
+	struct airoha_xr_pub *pub, *tmp;
+
+	if (xr_pub_ppe != ppe)
+		return;
+	genl_unregister_family(&airoha_xr_family);
+	list_for_each_entry_safe(pub, tmp, &ppe->xr_pub_entries, node)
+		airoha_xr_release(ppe, pub);
+	xr_pub_ppe = NULL;
+}
