+/* Based on Ryan Chen's token_info diagnostics; capture token fields while
+ * locked, format afterwards, and mark queue scalars as approximate snapshots.
+ * No raw DMA, frame contents, keys or register writes are exposed.
+ */
+static int mt7996_xr_token_info_read(struct seq_file *s, void *data)
+{
+ struct mt7996_dev *dev = dev_get_drvdata(s->private);
+ struct mt76_dev *mdev = &dev->mt76;
+ unsigned int tokens, size, first, wed, rx;
+ bool npu;
+ int i, ret;
+
+ ret = mutex_lock_interruptible(&mdev->mutex);
+ if (ret)
+  return ret;
+ npu = mt76_npu_device_active(mdev);
+ spin_lock_bh(&mdev->token_lock);
+ tokens = mdev->token_count; size = mdev->token_size;
+ first = mdev->token_start; wed = mdev->wed_token_count;
+ spin_unlock_bh(&mdev->token_lock);
+ spin_lock_bh(&mdev->rx_token_lock);
+ rx = mdev->rx_token_size;
+ spin_unlock_bh(&mdev->rx_token_lock);
+ seq_printf(s, "tokens=%u size=%u start=%u wed=%u rx_size=%u npu_active=%u\n",
+            tokens, size, first, wed, rx, npu);
+ seq_printf(s, "txfree_messages=%lld short_headers=%lld length_mismatches=%lld truncations=%lld\n",
+            atomic64_read(&dev->txfree_messages),
+            atomic64_read(&dev->txfree_short_headers),
+            atomic64_read(&dev->txfree_length_mismatches),
+            atomic64_read(&dev->txfree_truncations));
+ seq_puts(s, "queue_counters=approximate\n");
+ for (i = MT_RXQ_NPU0; i <= MT_RXQ_NPU1; i++) {
+  struct mt76_queue *q = &mdev->q_rx[i];
+  seq_printf(s, "npu_rx%d ndesc=%u queued=%u head=%u tail=%u napi_registered=%u napi_enabled=%u irq_registered=%u\n",
+             i - MT_RXQ_NPU0, READ_ONCE(q->ndesc), READ_ONCE(q->queued),
+             READ_ONCE(q->head), READ_ONCE(q->tail),
+             q->npu_napi_registered, q->npu_napi_enabled,
+             q->npu_irq_registered);
+ }
+ for (i = 0; i < __MT_MAX_BAND; i++) {
+  struct mt76_phy *phy = mdev->phys[i];
+  struct mt76_queue *q;
+  if (!phy || !phy->q_tx[0])
+   continue;
+  q = phy->q_tx[0];
+  seq_printf(s, "band=%d path=%s ndesc=%u queued=%u head=%u tail=%u\n", i,
+             mt76_queue_is_npu_tx(q) ? "npu" : "dma", READ_ONCE(q->ndesc),
+             READ_ONCE(q->queued), READ_ONCE(q->head), READ_ONCE(q->tail));
+ }
+ mutex_unlock(&mdev->mutex);
+ return 0;
+}
