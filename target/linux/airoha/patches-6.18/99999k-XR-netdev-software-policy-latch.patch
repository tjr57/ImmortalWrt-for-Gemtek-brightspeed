Subject: [PATCH] XR: latch L2 PPE off before TC/tcx/XDP/device-hook policy

Any user TC mutation (qdisc, class, filter, chain, shared action), tcx or XDP
program installation, and netdev or inet ingress netfilter hook registration
is software forwarding policy that MAC-only L2 PPE templates cannot represent.
Deliver a sticky LATCH through the core forwarding fence before the policy
becomes visible; registration reports earlier latches. Removing the policy
never reauthorizes binding. L2 publication therefore cannot use TC. NPU/PPE
opt-ins remain disabled.

--- a/drivers/net/ethernet/airoha/airoha_eth.h
+++ b/drivers/net/ethernet/airoha/airoha_eth.h
@@ -738,6 +738,7 @@
 	struct notifier_block l2_bridge_nb;
 	u32 l2_bridge_writers;
 	bool l2_policy_latched;
+	bool l2_netdev_policy_latched;
 	struct notifier_block l2_switchdev_nb;
 	struct notifier_block l2_switchdev_atomic_nb;
 	u64 l2_invalidations;
--- a/drivers/net/ethernet/airoha/airoha_ppe.c
+++ b/drivers/net/ethernet/airoha/airoha_ppe.c
@@ -1232,6 +1232,11 @@
 
 	spin_lock_bh(&ppe_lock);
 	ppe->l2_bridge_writers = state->writers;
+	/* TC/tcx/XDP/device-hook policy: sticky, never cleared here. INIT
+	 * carries latches that happened before this driver registered.
+	 */
+	if (state->latches)
+		ppe->l2_netdev_policy_latched = true;
 	/* INIT also invalidates any pre-registration snapshot. END advances the
 	 * generation so a snapshot from inside the mutation cannot be reused.
 	 */
@@ -1583,7 +1588,8 @@
 {
  bool allowed;
  spin_lock_bh(&ppe_lock);
- allowed = !ppe->l2_policy_latched && !ppe->l2_bridge_writers;
+ allowed = !ppe->l2_policy_latched && !ppe->l2_netdev_policy_latched &&
+	   !ppe->l2_bridge_writers;
  *generation = ppe->l2_generation;
  spin_unlock_bh(&ppe_lock);
  return allowed;
@@ -1596,8 +1602,8 @@
 static bool airoha_ppe_l2_ready_locked(struct airoha_ppe *ppe, u64 generation)
 {
 	lockdep_assert_held(&ppe_lock);
-	return !ppe->l2_policy_latched && !ppe->l2_bridge_writers &&
-	       generation == ppe->l2_generation;
+	return !ppe->l2_policy_latched && !ppe->l2_netdev_policy_latched &&
+	       !ppe->l2_bridge_writers && generation == ppe->l2_generation;
 }
 
