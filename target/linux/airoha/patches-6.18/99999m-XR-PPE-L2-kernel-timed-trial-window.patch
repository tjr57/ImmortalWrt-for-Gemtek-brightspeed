@@ -2954,6 +3080,7 @@
 	int err;
 
 	INIT_LIST_HEAD(&ppe->xr_pub_entries);
+	INIT_DELAYED_WORK(&ppe->xr_trial_work, airoha_xr_trial_work);
 	if (xr_pub_ppe)
 		return;
 	xr_pub_ppe = ppe;
@@ -2972,6 +3099,8 @@
 	if (xr_pub_ppe != ppe)
 		return;
 	genl_unregister_family(&airoha_xr_family);
+	cancel_delayed_work_sync(&ppe->xr_trial_work);
+	airoha_xr_trial_end(ppe);
 	list_for_each_entry_safe(pub, tmp, &ppe->xr_pub_entries, node)
 		airoha_xr_release(ppe, pub);
 	xr_pub_ppe = NULL;
