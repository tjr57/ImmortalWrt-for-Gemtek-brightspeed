+/* Counters describe transport lengths, they do not clamp counts or
+ * declare a firmware format invalid merely because lengths differ.
+ */
+static bool mt7996_txfree_record_length(struct mt7996_dev *dev,
+                                      const void *data, int len)
+{
+ atomic64_inc(&dev->txfree_messages);
+ if (len < 2 * (int)sizeof(__le32)) {
+  atomic64_inc(&dev->txfree_short_headers);
+  return false;
+ }
+ if (FIELD_GET(MT_TXFREE0_RX_BYTE, get_unaligned_le32(data)) != len)
+  atomic64_inc(&dev->txfree_length_mismatches);
+ return true;
+}
