Subject: [PATCH] wifi: mt76: select WLAN NPU attachment before DMA initialization
SPDX-License-Identifier: GPL-2.0-only

Keep normal PCIe DMA as the AP default while truncated NPU TXFREE messages
remain unresolved. Keep NPU support compiled and generic default enabled.
The parameter is immutable after load; no live DMA ownership switch.
Avoid allocating unused NPU coherent rings on the normal path.

--- a/npu.c
+++ b/npu.c
@@ -4,12 +4,21 @@
  * Author: Lorenzo Bianconi <lorenzo@kernel.org>
  */
 #include <linux/kernel.h>
+#include <linux/moduleparam.h>
 #include <net/flow_offload.h>
 #include <net/pkt_cls.h>
 
 #include "mt76.h"
 #include "dma.h"
 #include "mt76_connac.h"
+
+/* Select at build time; changing DMA ownership requires a fresh probe. */
+#ifndef MT76_NPU_ENABLE_DEFAULT
+#define MT76_NPU_ENABLE_DEFAULT 1
+#endif
+static bool npu_enable = MT76_NPU_ENABLE_DEFAULT;
+module_param_named(npu_enable, npu_enable, bool, 0400);
+MODULE_PARM_DESC(npu_enable, "Attach WLAN NPU at probe (read-only, boot policy)");
 
 #define MT76_NPU_RX_BUF_SIZE	(1800 + \
 				 SKB_DATA_ALIGN(sizeof(struct skb_shared_info)))
@@ -495,6 +504,11 @@
 	struct airoha_npu *npu;
 	int err = 0;
 
+	if (!npu_enable) {
+		dev_info(dev->dev, "WLAN NPU attachment disabled by boot policy; using PCIe DMA\n");
+		return 0;
+	}
+
 	mutex_lock(&dev->mutex);
 
 	npu = airoha_npu_get(dev->dev);
--- a/mt7996/npu.c
+++ b/mt7996/npu.c
@@ -560,6 +560,10 @@
 {
 	int i, err;
 
+	/* Do not allocate NPU rings when probe selected normal PCIe DMA. */
+	if (!mt76_npu_device_active(&dev->mt76))
+		return 0;
+
 	BUILD_BUG_ON(ARRAY_SIZE(dev->npu_txd_addr) % 3);
 
 	for (i = 0; i < ARRAY_SIZE(dev->npu_txd_addr); i += 3) {
