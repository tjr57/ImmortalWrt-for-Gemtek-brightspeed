--- a/include/linux/netdev_fwd_policy.h
+++ b/include/linux/netdev_fwd_policy.h
@@ -15,15 +15,23 @@
  * BEGIN/END, including writers already in progress. Receivers must mirror the
  * absolute count. The fence is never held across the mutation, so a scope may
  * sleep; it must only be entered from process or softirq context.
+ *
+ * LATCH is sticky until reboot: a software forwarding policy that dependent
+ * caches cannot represent (user TC configuration, tcx/XDP programs, netdev
+ * and inet ingress netfilter hooks) is about to become visible. It is
+ * delivered before that policy is published; removing the policy never
+ * clears it. INIT reports earlier latches through @latches.
  */
 enum netdev_fwd_policy_event {
 	NETDEV_FWD_POLICY_INIT,
 	NETDEV_FWD_POLICY_BEGIN,
 	NETDEV_FWD_POLICY_END,
+	NETDEV_FWD_POLICY_LATCH,
 };
 
 struct netdev_fwd_policy_state {
 	u32 writers;
+	u32 latches;	/* saturating; nonzero means latched */
 };
 
 struct notifier_block;
@@ -32,6 +40,7 @@
 void netdev_fwd_policy_unregister(struct notifier_block *nb);
 void netdev_fwd_policy_begin(void);
 void netdev_fwd_policy_end(void);
+void netdev_fwd_policy_latch(void);
 
 DEFINE_LOCK_GUARD_0(netdev_fwd_change, netdev_fwd_policy_begin(),
 		    netdev_fwd_policy_end())
