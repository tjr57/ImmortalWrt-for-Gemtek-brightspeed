--- a/net/core/fwd_policy.c
+++ b/net/core/fwd_policy.c
@@ -58,3 +58,16 @@
 	spin_unlock_bh(&netdev_fwd_policy_lock);
 }
 EXPORT_SYMBOL_GPL(netdev_fwd_policy_end);
+
+/* Process context, before the policy is published. Sticky until reboot. */
+void netdev_fwd_policy_latch(void)
+{
+	spin_lock_bh(&netdev_fwd_policy_lock);
+	if (netdev_fwd_policy_state.latches != U32_MAX)
+		netdev_fwd_policy_state.latches++;
+	atomic_notifier_call_chain(&netdev_fwd_policy_chain,
+				   NETDEV_FWD_POLICY_LATCH,
+				   &netdev_fwd_policy_state);
+	spin_unlock_bh(&netdev_fwd_policy_lock);
+}
+EXPORT_SYMBOL_GPL(netdev_fwd_policy_latch);
