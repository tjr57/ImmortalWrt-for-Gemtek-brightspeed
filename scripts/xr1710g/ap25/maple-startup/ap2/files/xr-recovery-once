#!/bin/sh
# AP2 only, opt-in next-boot recovery qualification. No NPU/module changes.
[ "${1:-}" = boot ] || exit 2
request=/etc/xr-recovery.once
binary=/usr/libexec/xr-diag-recovery
store=/root/xr-diag-journal
[ -e "$request" ] || [ -L "$request" ] || exit 0
[ -f "$request" ] && [ ! -L "$request" ] || exit 1
permissions=$(ls -nd "$request") || exit 1
set -- $permissions
[ "$1:$3" = -rw-------:0 ] || exit 1
[ "$(wc -c < "$request")" -le 128 ] || exit 1
line=$(cat "$request") || exit 1
old=${line#xr-recovery-v1 }
[ "$line" = "xr-recovery-v1 $old" ] || exit 1
[ "${#old}" = 36 ] || exit 1
printf '%s\n' "$old" | grep -Eq '^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$' || exit 1
boot=$(cat /proc/sys/kernel/random/boot_id) || exit 1
[ "${#boot}" = 36 ] || exit 1
printf '%s\n' "$boot" | grep -Eq '^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$' || exit 1
[ "$old" != "$boot" ] || exit 0
[ "$(cat /tmp/sysinfo/board_name)" = gemtek,xr1710g ] || exit 1
/usr/sbin/xr1710g-ap-role | grep -q '"role"[[:space:]]*:[[:space:]]*"ap2"' || exit 1
[ -x "$binary" ] && [ ! -L "$binary" ] || exit 1
[ -x /usr/libexec/xr-diag-capture ] && [ ! -L /usr/libexec/xr-diag-capture ] || exit 1
[ ! -L /root ] && [ ! -L "$store" ] || exit 1
umask 077
if [ ! -e "$store" ]; then mkdir -m 700 "$store" || exit 1; fi
[ -d "$store" ] || exit 1
permissions=$(ls -nd "$store") || exit 1
set -- $permissions
[ "$1:$3" = drwx------:0 ] || exit 1
record="$store/$boot"
[ ! -e "$record" ] && [ ! -L "$record" ] || exit 1
[ ! -e "$record.launch" ] && [ ! -L "$record.launch" ] || exit 1
rm -f "$request" || exit 1
sync
"$binary" "$record" 180 </dev/null >"$record.launch" 2>&1 &
pid=$!
for attempt in 1 2 3 4 5 6; do
 [ ! -e "$record/aborted.json" ] || exit 1
 [ -f "$record/ready.json" ] && exit 0
 kill -0 "$pid" 2>/dev/null || exit 1
 sleep 1
done
exit 1
