--- /dev/null
+++ b/net/core/fwd_policy.c
@@ -0,0 +1,60 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/* Serialize dependent offload caches with netdevice and bridge forwarding
+ * mutations. The lock is never held across the mutation. Callbacks only
+ * revoke/mirror state under their own cache lock; publishers never acquire
+ * this lock. Moved from net/bridge so core netdevice scopes share one count.
+ */
+#include <linux/export.h>
+#include <linux/netdev_fwd_policy.h>
+#include <linux/notifier.h>
+#include <linux/spinlock.h>
+
+static DEFINE_SPINLOCK(netdev_fwd_policy_lock);
+static ATOMIC_NOTIFIER_HEAD(netdev_fwd_policy_chain);
+static struct netdev_fwd_policy_state netdev_fwd_policy_state;
+
+int netdev_fwd_policy_register(struct notifier_block *nb)
+{
+	int err;
+
+	spin_lock_bh(&netdev_fwd_policy_lock);
+	err = atomic_notifier_chain_register(&netdev_fwd_policy_chain, nb);
+	if (!err)
+		nb->notifier_call(nb, NETDEV_FWD_POLICY_INIT,
+				  &netdev_fwd_policy_state);
+	spin_unlock_bh(&netdev_fwd_policy_lock);
+	return err;
+}
+EXPORT_SYMBOL_GPL(netdev_fwd_policy_register);
+
+void netdev_fwd_policy_unregister(struct notifier_block *nb)
+{
+	/* This waits for RCU readers and must run without our spinlock held. */
+	atomic_notifier_chain_unregister(&netdev_fwd_policy_chain, nb);
+}
+EXPORT_SYMBOL_GPL(netdev_fwd_policy_unregister);
+
+void netdev_fwd_policy_begin(void)
+{
+	spin_lock_bh(&netdev_fwd_policy_lock);
+	if (!WARN_ON_ONCE(netdev_fwd_policy_state.writers == U32_MAX))
+		netdev_fwd_policy_state.writers++;
+	atomic_notifier_call_chain(&netdev_fwd_policy_chain,
+				   NETDEV_FWD_POLICY_BEGIN,
+				   &netdev_fwd_policy_state);
+	spin_unlock_bh(&netdev_fwd_policy_lock);
+}
+EXPORT_SYMBOL_GPL(netdev_fwd_policy_begin);
+
+void netdev_fwd_policy_end(void)
+{
+	spin_lock_bh(&netdev_fwd_policy_lock);
+	/* An unbalanced END would publish while a writer is still active. */
+	if (!WARN_ON_ONCE(!netdev_fwd_policy_state.writers))
+		netdev_fwd_policy_state.writers--;
+	atomic_notifier_call_chain(&netdev_fwd_policy_chain,
+				   NETDEV_FWD_POLICY_END,
+				   &netdev_fwd_policy_state);
+	spin_unlock_bh(&netdev_fwd_policy_lock);
+}
+EXPORT_SYMBOL_GPL(netdev_fwd_policy_end);
