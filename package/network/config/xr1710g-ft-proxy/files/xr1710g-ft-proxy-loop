#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# No config publication or radio reload. A running worker waits while FT is off.
get() { uci -q get "$1" 2>/dev/null; }
advertise() {
 [ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" = gemtek,xr1710g ] || return
 [ "$(get xr1710g_ap_configurator.roaming.enabled)" = 1 ] || return
 [ "$(get wireless.xr_users.xr1710g_owner)" = users ] || return
 [ "$(get wireless.xr_users.mode)" = ap ] || return
 [ "$(get wireless.xr_users.ieee80211r)" = 1 ] || return
 [ "$(get wireless.xr_users.ft_iface)" = br-lan.1 ] || return
 [ "$(get wireless.xr_users.disabled)" != 1 ] || return
 [ -d /sys/class/net/mesh6g ] || return
 # Never advertise before the backhaul has a station authorized for data.
 iw dev mesh6g station dump 2>/dev/null | grep -q 'authorized:.*yes' || return
 case "$(cat /sys/class/net/br-lan.1/address 2>/dev/null)" in
  00:58:28:d7:85:08) role=ap1; source=00:58:28:d7:85:0b ;;
  00:58:28:d7:49:f1) role=ap2; source=00:58:28:d7:49:f4 ;;
  *) return ;;
 esac
 for link in /sys/class/net/*; do
  [ "$(cat "$link/address" 2>/dev/null)" = "$source" ] || continue
  /usr/libexec/xr1710g-ft-proxy-send "$role" "${link##*/}"
  return
 done
}
case "${1:-}" in
 once) advertise ;;
 run) while :; do advertise; sleep 15; done ;;
 *) exit 2 ;;
esac
