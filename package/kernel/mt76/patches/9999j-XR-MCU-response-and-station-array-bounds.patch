+static bool
+mt7996_mcu_rx_check(struct mt7996_dev *dev, struct sk_buff *skb,
+		    unsigned int required, bool header)
+{
+	if (skb->len < required) {
+		if (header)
+			atomic64_inc(&dev->mcu_short_headers);
+		else
+			atomic64_inc(&dev->mcu_short_payloads);
+		return false;
+	}
+	if (!pskb_may_pull(skb, required)) {
+		atomic64_inc(&dev->mcu_pull_failures);
+		return false;
+	}
+	return true;
+}
