--- /dev/null
+++ b/mt7996/xr_ps_audit.h
@@ -0,0 +1,97 @@
+/* SPDX-License-Identifier: BSD-3-Clause-Clear */
+/* Opt-in scalar PS notification audit; no firmware commands or packet data. */
+#ifndef __XR_PS_AUDIT_H
+#define __XR_PS_AUDIT_H
+#include <linux/moduleparam.h>
+#include <linux/ktime.h>
+#include <linux/spinlock.h>
+
+#define XR_PS_AUDIT_DISABLED 65535
+#define XR_PS_AUDIT_SIZE 32
+struct xr_ps_audit_event {
+ u64 seq, ns;
+ u16 wcid;
+ u8 tag, requested, before, after;
+};
+static DEFINE_SPINLOCK(xr_ps_audit_lock);
+static u16 xr_ps_audit_wcid = XR_PS_AUDIT_DISABLED;
+static u64 xr_ps_audit_total;
+static struct xr_ps_audit_event xr_ps_audit_ring[XR_PS_AUDIT_SIZE];
+
+static int xr_ps_audit_select_set(const char *val, const struct kernel_param *kp)
+{
+ unsigned long flags;
+ u16 selected;
+ int ret = kstrtou16(val, 0, &selected);
+ if (ret)
+  return ret;
+ if (selected >= 2048 && selected != XR_PS_AUDIT_DISABLED)
+  return -ERANGE;
+ spin_lock_irqsave(&xr_ps_audit_lock, flags);
+ WRITE_ONCE(xr_ps_audit_wcid, selected);
+ xr_ps_audit_total = 0;
+ memset(xr_ps_audit_ring, 0, sizeof(xr_ps_audit_ring));
+ spin_unlock_irqrestore(&xr_ps_audit_lock, flags);
+ return 0;
+}
+
+static int xr_ps_audit_select_get(char *buf, const struct kernel_param *kp)
+{
+ return scnprintf(buf, PAGE_SIZE, "%u\n", READ_ONCE(xr_ps_audit_wcid));
+}
+
+static void xr_ps_audit_record(u16 wcid, u8 tag, bool ps, bool before, bool after)
+{
+ struct xr_ps_audit_event *e;
+ unsigned long flags;
+ if (wcid >= 2048 || READ_ONCE(xr_ps_audit_wcid) != wcid)
+  return;
+ spin_lock_irqsave(&xr_ps_audit_lock, flags);
+ if (xr_ps_audit_wcid != wcid)
+  goto out;
+ e = &xr_ps_audit_ring[xr_ps_audit_total % XR_PS_AUDIT_SIZE];
+ *e = (struct xr_ps_audit_event) {
+  .seq = ++xr_ps_audit_total, .ns = ktime_get_mono_fast_ns(),
+  .wcid = wcid, .tag = tag, .requested = ps, .before = before, .after = after,
+ };
+out:
+ spin_unlock_irqrestore(&xr_ps_audit_lock, flags);
+}
+
+static int xr_ps_audit_events_get(char *buf, const struct kernel_param *kp)
+{
+ struct xr_ps_audit_event events[XR_PS_AUDIT_SIZE];
+ unsigned long flags;
+ u64 total;
+ u16 selected;
+ unsigned int count, i, length;
+ spin_lock_irqsave(&xr_ps_audit_lock, flags);
+ total = xr_ps_audit_total;
+ selected = xr_ps_audit_wcid;
+ count = min_t(u64, total, XR_PS_AUDIT_SIZE);
+ for (i = 0; i < count; i++)
+  events[i] = xr_ps_audit_ring[(total - count + i) % XR_PS_AUDIT_SIZE];
+ spin_unlock_irqrestore(&xr_ps_audit_lock, flags);
+ length = scnprintf(buf, PAGE_SIZE, "schema=1 selected=%u total=%llu retained=%u\n",
+                    selected, (unsigned long long)total, count);
+ for (i = 0; i < count; i++) {
+  struct xr_ps_audit_event *e = &events[i];
+  length += scnprintf(buf + length, PAGE_SIZE - length,
+      "seq=%llu ns=%llu wcid=%u tag=%u requested=%u before=%u after=%u\n",
+      (unsigned long long)e->seq, (unsigned long long)e->ns,
+      e->wcid, e->tag, e->requested, e->before, e->after);
+ }
+ return length;
+}
+
+static const struct kernel_param_ops xr_ps_audit_select_ops = {
+ .set = xr_ps_audit_select_set, .get = xr_ps_audit_select_get,
+};
+static const struct kernel_param_ops xr_ps_audit_events_ops = {
+ .get = xr_ps_audit_events_get,
+};
+module_param_cb(ps_audit_wcid, &xr_ps_audit_select_ops, NULL, 0600);
+MODULE_PARM_DESC(ps_audit_wcid, "PS event audit WCID 0..2047; 65535 disables; each write resets scalar ring");
+module_param_cb(ps_audit_events, &xr_ps_audit_events_ops, NULL, 0400);
+MODULE_PARM_DESC(ps_audit_events, "Bounded PS notification records for selected WCID; no frame data");
+#endif
