+/* Reset and teardown share this software state. napi_disable twice waits
+ * forever; netif_napi_del of an enabled instance is invalid. Only NPU queues
+ * need the additional partial-init/teardown tracking, other RX paths retain
+ * their previous lifecycle.
+ */
+static inline void mt76_rx_napi_disable(struct mt76_dev *dev, int qid)
+{
+	bool npu = qid == MT_RXQ_NPU0 || qid == MT_RXQ_NPU1;
+	if (npu && !dev->q_rx[qid].npu_napi_enabled)
+		return;
+	napi_disable(&dev->napi[qid]);
+	if (npu)
+		dev->q_rx[qid].npu_napi_enabled = false;
+}
+static inline void mt76_rx_napi_enable(struct mt76_dev *dev, int qid)
+{
+	bool npu = qid == MT_RXQ_NPU0 || qid == MT_RXQ_NPU1;
+	if (npu && dev->q_rx[qid].npu_napi_enabled)
+		return;
+	napi_enable(&dev->napi[qid]);
+	if (npu)
+		dev->q_rx[qid].npu_napi_enabled = true;
+}
+
