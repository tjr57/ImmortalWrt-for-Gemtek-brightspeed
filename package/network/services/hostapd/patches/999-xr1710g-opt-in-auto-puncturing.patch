 #endif /* CONFIG_DRIVER_NL80211_BRCM */
 
 
+static void nl80211_xr_pp_event(struct wpa_driver_nl80211_data *drv,
+                                u32 subcmd, u8 *data, size_t len)
+{
+	struct nlattr *outer[NL80211_ATTR_MAX + 1], *pp[4];
+	struct i802_bss *bss;
+	union wpa_event_data ev;
+	unsigned freq;
+	int i;
+	if (subcmd != 5 || !data ||
+	    nla_parse(outer, NL80211_ATTR_MAX, (struct nlattr *)data, len, NULL) ||
+	    !outer[NL80211_ATTR_WIPHY_FREQ] ||
+	    nla_len(outer[NL80211_ATTR_WIPHY_FREQ]) != sizeof(u32) ||
+	    !outer[NL80211_ATTR_VENDOR_DATA] ||
+	    nla_parse_nested(pp, 3, outer[NL80211_ATTR_VENDOR_DATA], NULL) ||
+	    !pp[3] || nla_len(pp[3]) != sizeof(u16))
+		return;
+	freq = nla_get_u32(outer[NL80211_ATTR_WIPHY_FREQ]);
+	for (bss = drv->first_bss; bss; bss = bss->next) {
+		if (!bss->xr_pp_mode)
+			continue;
+		for (i = 0; i < MAX_NUM_MLD_LINKS; i++) {
+			if (bss->links[i].freq != freq ||
+			    (bss->valid_links && !(bss->valid_links & BIT(i))))
+				continue;
+			os_memset(&ev, 0, sizeof(ev));
+			ev.ch_switch.freq = freq;
+			ev.ch_switch.link_id = bss->valid_links ? i : -1;
+			ev.ch_switch.punct_bitmap = nla_get_u16(pp[3]);
+			wpa_supplicant_event(bss->ctx, EVENT_XR_PP_BITMAP_UPDATE, &ev);
+			return;
+		}
+	}
+}
+
