-/* Use actual bridge port membership, PVID and output tag policy. */
-static bool airoha_ppe_l2_context(struct flow_rule *rule,
-                                struct net_device *odev,
-                                struct airoha_flow_data *data,
-                                struct airoha_l2_flow_key *key)
+/* Validate an owner-published L2 template against the live bridge and derive
+ * the bridge's own egress tagging; no caller-supplied action can widen it.
+ * Untagged ingress must name the ingress PVID; tagged-to-tagged stays in
+ * software because the template cannot preserve per-packet PCP/DEI. MTU,
+ * port policy, MST, per-VLAN state and FDB direction match the software
+ * bridge. Caller holds RTNL (STP state accessor) and RCU.
+ */
+static bool airoha_ppe_l2_validate(struct net_device *indev,
+				   struct net_device *odev, bool tagged,
+				   u16 vid, const u8 *src, const u8 *dst,
+				   struct airoha_flow_data *data,
+				   struct airoha_l2_flow_key *key)
 {
- struct flow_match_meta meta;
- struct net_device *indev, *master;
- struct bridge_vlan_info info;
- bool tagged = flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_VLAN);
- bool untagged = true, valid = false;
- u16 vid = 0, proto;
-
- if (!odev || !airoha_ppe_l2_rule_exact(rule))
-  return false;
- flow_rule_match_meta(rule, &meta);
- rcu_read_lock();
- indev = dev_get_by_index_rcu(dev_net(odev), meta.key->ingress_ifindex);
- if (!indev || indev == odev || is_vlan_dev(indev) || is_vlan_dev(odev) ||
-     !netif_is_bridge_port(indev) || !netif_is_bridge_port(odev) ||
-     !airoha_ppe_l2_port_eligible(indev) ||
-     !airoha_ppe_l2_port_eligible(odev))
-  goto out;
- /* The software bridge drops frames above the egress MTU; a bound flow is
-  * not known to enforce that limit. Only accept pairs where every frame
-  * admitted on ingress also fits egress. MTU changes revoke inside
-  * netdev_fwd_change.
-  */
- if (READ_ONCE(odev->mtu) < READ_ONCE(indev->mtu))
-  goto out;
- master = airoha_ppe_foe_get_bridge_master_rcu(indev);
- if (!master || br_mst_enabled(master) ||
-     !net_eq(dev_net(indev), dev_net(odev)) ||
-     airoha_ppe_foe_get_bridge_master_rcu(odev) != master)
-  goto out;
- if (br_vlan_enabled(master)) {
-  if (br_vlan_get_proto(master, &proto) || proto != ETH_P_8021Q)
-   goto out;
-  if (tagged) {
-   struct flow_match_vlan vlan;
-   flow_rule_match_vlan(rule, &vlan);
-   vid = vlan.key->vlan_id;
-   if (vlan.mask->vlan_id != VLAN_VID_MASK ||
-       vlan.key->vlan_tpid != htons(ETH_P_8021Q) ||
-       vlan.mask->vlan_tpid != htons(0xffff))
-    goto out;
-  } else if (br_vlan_get_pvid_rcu(indev, &vid)) {
-   goto out;
-  }
-  if (!vid || vid >= VLAN_VID_MASK ||
-      br_vlan_get_info_rcu(indev, vid, &info) ||
-      br_vlan_get_info_rcu(odev, vid, &info) ||
-      !br_vlan_forwarding_rcu(indev, vid) ||
-      !br_vlan_forwarding_rcu(odev, vid))
-   goto out;
-  untagged = !!(info.flags & BRIDGE_VLAN_INFO_UNTAGGED);
- } else if (tagged) {
-  goto out;
- }
- /* A normal bridge preserves PCP/DEI on tagged-to-tagged forwarding.
-  * POP/PUSH with priority zero is a valid explicit TC action, but does not
-  * preserve that bridge policy for all packets of a MAC-only template.
-  */
- if (tagged && !untagged)
-  goto out;
- if (!br_fdb_forward_to_rcu(master, indev, data->eth.h_source, vid) ||
-     !br_fdb_forward_to_rcu(master, odev, data->eth.h_dest, vid))
-  goto out;
- if (!airoha_ppe_l2_actions(rule, vid, tagged, untagged, data))
-  goto out;
- key->net_cookie = dev_net(indev)->net_cookie;
- key->ingress_ifindex = indev->ifindex;
- key->bridge_ifindex = master->ifindex;
- key->vid = vid;
- key->vlan_proto = htons(ETH_P_8021Q);
- key->ingress_tagged = tagged;
- ether_addr_copy(key->source, data->eth.h_source);
- ether_addr_copy(key->dest, data->eth.h_dest);
- valid = true;
-out:
- rcu_read_unlock();
- return valid;
-}
+	struct bridge_vlan_info in_info, out_info;
+	struct net_device *master;
+	bool untagged = true;
+	u16 proto, pvid;
 
+	if (!indev || !odev || indev == odev || is_vlan_dev(indev) ||
+	    is_vlan_dev(odev) || !netif_is_bridge_port(indev) ||
+	    !netif_is_bridge_port(odev) ||
+	    !airoha_ppe_l2_port_eligible(indev) ||
+	    !airoha_ppe_l2_port_eligible(odev))
+		return false;
+	/* The software bridge drops frames above the egress MTU; a bound flow is
+	 * not known to enforce that limit. MTU changes revoke inside
+	 * netdev_fwd_change.
+	 */
+	if (READ_ONCE(odev->mtu) < READ_ONCE(indev->mtu))
+		return false;
+	if (!is_valid_ether_addr(src) || !is_valid_ether_addr(dst) ||
+	    ether_addr_equal(src, dst))
+		return false;
+	master = airoha_ppe_foe_get_bridge_master_rcu(indev);
+	if (!master || br_mst_enabled(master) ||
+	    !net_eq(dev_net(indev), dev_net(odev)) ||
+	    airoha_ppe_foe_get_bridge_master_rcu(odev) != master)
+		return false;
+	/* Frames to the bridge's own address are delivered locally. */
+	if (ether_addr_equal(dst, master->dev_addr) ||
+	    ether_addr_equal(dst, indev->dev_addr))
+		return false;
+	if (br_vlan_enabled(master)) {
+		if (br_vlan_get_proto(master, &proto) || proto != ETH_P_8021Q)
+			return false;
+		if (!vid || vid >= VLAN_VID_MASK)
+			return false;
+		if (!tagged && (br_vlan_get_pvid_rcu(indev, &pvid) || pvid != vid))
+			return false;
+		if (br_vlan_get_info_rcu(indev, vid, &in_info) ||
+		    br_vlan_get_info_rcu(odev, vid, &out_info) ||
+		    !br_vlan_forwarding_rcu(indev, vid) ||
+		    !br_vlan_forwarding_rcu(odev, vid))
+			return false;
+		untagged = !!(out_info.flags & BRIDGE_VLAN_INFO_UNTAGGED);
+	} else if (tagged || vid) {
+		/* Tagged packets on a nonfiltering bridge have no isolated VID. */
+		return false;
+	}
+	if (tagged && !untagged)
+		return false;
+	if (!br_fdb_forward_to_rcu(master, indev, src, vid) ||
+	    !br_fdb_forward_to_rcu(master, odev, dst, vid))
+		return false;
+	memset(&data->vlan, 0, sizeof(data->vlan));
+	if (!untagged) {
+		data->vlan.num = 1;
+		data->vlan.hdr[0].id = vid;
+		data->vlan.hdr[0].proto = htons(ETH_P_8021Q);
+	}
+	ether_addr_copy(data->eth.h_source, src);
+	ether_addr_copy(data->eth.h_dest, dst);
+	memset(key, 0, sizeof(*key));
+	key->net_cookie = dev_net(indev)->net_cookie;
+	key->ingress_ifindex = indev->ifindex;
+	key->bridge_ifindex = master->ifindex;
+	key->vid = vid;
+	key->vlan_proto = htons(ETH_P_8021Q);
+	key->ingress_tagged = tagged;
+	ether_addr_copy(key->source, src);
+	ether_addr_copy(key->dest, dst);
+	return true;
+}
 
