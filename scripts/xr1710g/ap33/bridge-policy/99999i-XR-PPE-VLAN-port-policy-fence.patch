Subject: [PATCH] XR: fence VLAN and bridge-port policy changes before PPE binding

--- a/net/bridge/br_vlan.c
+++ b/net/bridge/br_vlan.c
@@ -778,6 +778,7 @@
 	struct net_bridge_vlan *vlan;
 	int ret;
 
+	guard(br_fwd_change)(br->dev);
 	ASSERT_RTNL();
 
 	*changed = false;
@@ -821,6 +822,7 @@
 	struct net_bridge_vlan_group *vg;
 	struct net_bridge_vlan *v;
 
+	guard(br_fwd_change)(br->dev);
 	ASSERT_RTNL();
 
 	vg = br_vlan_group(br);
@@ -840,6 +842,7 @@
 {
 	struct net_bridge_vlan_group *vg;
 
+	guard(br_fwd_change)(br->dev);
 	ASSERT_RTNL();
 
 	vg = br_vlan_group(br);
@@ -900,6 +903,7 @@
 	if (br_opt_get(br, BROPT_VLAN_ENABLED) == !!val)
 		return 0;
 
+	guard(br_fwd_change)(br->dev);
 	br_opt_toggle(br, BROPT_VLAN_ENABLED, !!val);
 
 	err = switchdev_port_attr_set(br->dev, &attr, extack);
@@ -955,6 +959,7 @@
 	if (br->vlan_proto == proto)
 		return 0;
 
+	guard(br_fwd_change)(br->dev);
 	err = switchdev_port_attr_set(br->dev, &attr, extack);
 	if (err && err != -EOPNOTSUPP)
 		return err;
@@ -1105,6 +1110,7 @@
 	u16 old_pvid;
 	int err = 0;
 
+	guard(br_fwd_change)(br->dev);
 	if (!pvid) {
 		br_vlan_disable_default_pvid(br);
 		return 0;
@@ -1313,6 +1319,7 @@
 	struct net_bridge_vlan *vlan;
 	int ret;
 
+	guard(br_fwd_change)(port->br->dev);
 	ASSERT_RTNL();
 
 	*changed = false;
@@ -1356,6 +1363,7 @@
 {
 	struct net_bridge_vlan *v;
 
+	guard(br_fwd_change)(port->br->dev);
 	ASSERT_RTNL();
 
 	v = br_vlan_find(nbp_vlan_group(port), vid);
@@ -1371,6 +1379,7 @@
 {
 	struct net_bridge_vlan_group *vg;
 
+	guard(br_fwd_change)(port->br->dev);
 	ASSERT_RTNL();
 
 	vg = nbp_vlan_group(port);
@@ -1553,6 +1562,30 @@
 	return 0;
 }
 EXPORT_SYMBOL_GPL(br_vlan_get_info_rcu);
+
+/* Membership alone is insufficient: a VLAN can be blocked while its
+ * port remains forwarding (including without MST). Caller holds RCU.
+ */
+bool br_vlan_forwarding_rcu(const struct net_device *dev, u16 vid)
+{
+	struct net_bridge_vlan_group *vg;
+	struct net_bridge_vlan *v;
+	struct net_bridge_port *p;
+
+	p = br_port_get_check_rcu(dev);
+	if (p)
+		vg = nbp_vlan_group_rcu(p);
+	else if (netif_is_bridge_master(dev))
+		vg = br_vlan_group_rcu(netdev_priv(dev));
+	else
+		return false;
+
+	v = br_vlan_find(vg, vid);
+	return v && br_vlan_should_use(v) &&
+	       READ_ONCE(v->state) == BR_STATE_FORWARDING;
+}
+EXPORT_SYMBOL_GPL(br_vlan_forwarding_rcu);
+
 
