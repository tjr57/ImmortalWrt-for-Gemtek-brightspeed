+/* Diagnostic profile established by AP44 on the exact EN7581 firmware.
+ * Only EtherType blacklist slots 3/4 change. This is not an assertion of
+ * per-packet preservation and is never selected by ordinary trial-arm.
+ */
+static int airoha_xr_native_profile(struct airoha_ppe *ppe, bool enable)
+{
+	struct airoha_eth *eth = ppe->eth;
+	unsigned int i;
+
+	lockdep_assert_held(&ppe_lock);
+	if (!airoha_is_7581(eth) || eth->soc->num_ppe != 2)
+		return -EOPNOTSUPP;
+	if (enable) {
+		/* Validate both engines before the first write. Mode 3 is rejected. */
+		for (i = 0; i < 2; i++) {
+			u32 base = 0xc00 + i * 0x1000;
+
+			if (airoha_fe_rr(eth, base + 0x288) != 0x001d077f ||
+			    airoha_fe_rr(eth, base + 0x28c) != 0x1b ||
+			    airoha_fe_rr(eth, base + 0x204) != 0x00198000 ||
+			    airoha_fe_rr(eth, base + 0x2d0) != 0x88a88100 ||
+			    airoha_fe_rr(eth, base + 0x2d4) != 0x08000000 ||
+			    airoha_fe_rr(eth, base + 0x2d8) != 0x000086dd)
+				return -EINVAL;
+		}
+	}
+	for (i = 0; i < 2; i++) {
+		u32 offset = 0xc00 + i * 0x1000 + 0x28c;
+
+		if (!enable && airoha_fe_rr(eth, offset) != 3)
+			continue; /* Do not overwrite an externally changed profile. */
+		airoha_fe_wr(eth, offset, enable ? 3 : 0x1b);
+	}
+	for (i = 0; i < 2; i++) {
+		u32 offset = 0xc00 + i * 0x1000 + 0x28c;
+
+		if (airoha_fe_rr(eth, offset) != (enable ? 3 : 0x1b)) {
+			if (enable)
+				airoha_xr_native_profile(ppe, false);
+			return -EIO;
+		}
+	}
+	return 0;
+}
