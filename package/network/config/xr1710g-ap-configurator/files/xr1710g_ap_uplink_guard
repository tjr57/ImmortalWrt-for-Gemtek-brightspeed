#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only
START=98
STOP=10
USE_PROCD=1

start_service() {
	[ -f /etc/xr1710g-ap-profile ] || return 1
	# default_postinst enables packaged init scripts. A saved opt-in is therefore
	# required before starting this service, including after an upgrade.
	[ "$(uci -q get xr1710g_ap_configurator.uplink_guard.deployed)" = 1 ] ||
		{ logger -t xr1710g-uplink-guard 'not deployed; users gate remains closed'; return 1; }
	procd_open_instance
	procd_set_param command /usr/sbin/xr1710g-ap-uplink-guard run
	procd_set_param respawn 3600 5 5
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() { /usr/sbin/xr1710g-ap-uplink-guard stop; }
reload_service() { /usr/sbin/xr1710g-ap-uplink-guard once; }
service_triggers() { procd_add_reload_trigger xr1710g_ap_configurator network wireless; }
