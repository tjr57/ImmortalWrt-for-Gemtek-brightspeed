+/* MTK0xcc: send only for an explicit auto opt-in or an auto->manual change. */
+static int nl80211_xr_pp_mode(struct i802_bss *bss, u8 mode, s8 link_id, u16 bitmap)
+{
+	struct nl_msg *msg = nl80211_bss_msg(bss, 0, NL80211_CMD_VENDOR);
+	struct nlattr *nest;
+	int ret = -ENOBUFS;
+	if (!msg)
+		return ret;
+	if (nla_put_u32(msg, NL80211_ATTR_VENDOR_ID, 0x000ce7) ||
+	    nla_put_u32(msg, NL80211_ATTR_VENDOR_SUBCMD, 0xcc))
+		goto fail;
+	nest = nla_nest_start(msg, NL80211_ATTR_VENDOR_DATA);
+	if (!nest || nla_put_u8(msg, 1, mode) ||
+	    (link_id >= 0 && nla_put_u8(msg, 2, link_id)) ||
+	    nla_put_u16(msg, 3, bitmap))
+		goto fail;
+	nla_nest_end(msg, nest);
+	return send_and_recv_cmd(bss->drv, msg);
+fail:
+	nlmsg_free(msg);
+	return ret;
+}
+
