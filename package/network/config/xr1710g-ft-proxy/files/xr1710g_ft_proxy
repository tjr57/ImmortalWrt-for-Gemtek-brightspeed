#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only
USE_PROCD=1
START=96
STOP=10
start_service() {
 procd_open_instance
 procd_set_param command /usr/libexec/xr1710g-ft-proxy-loop run
 procd_set_param respawn 3600 5 5
 procd_close_instance
}
service_triggers() {
 procd_add_reload_trigger wireless xr1710g_ap_configurator network
}
reload_service() {
 /usr/libexec/xr1710g-ft-proxy-loop once
}
