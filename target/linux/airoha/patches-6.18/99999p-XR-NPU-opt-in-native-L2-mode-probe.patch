+/* The shipped EN7581/MT7996 firmware has a mode1 branch selecting flow
+ * configuration 0x8000 instead of the IPv4/IPv6 parser enables. Its native
+ * L2 packet semantics need hardware qualification. This diagnostic selector
+ * does not grant any binding capability: AP39 DS-field containment remains.
+ * Built-in driver: select at runtime before first PPE init, then lock until
+ * reboot. No register changes occur in the parameter setter.
+ */
+static bool ppe_mode1_probe;
+static bool ppe_mode_locked;
+static DEFINE_MUTEX(ppe_mode_mutex);
+
+static int airoha_ppe_mode_set(const char *val, const struct kernel_param *kp)
+{
+	bool mode;
+	int err = kstrtobool(val, &mode);
+
+	if (err)
+		return err;
+	mutex_lock(&ppe_mode_mutex);
+	if (ppe_mode_locked)
+		err = -EBUSY;
+	else
+		*(bool *)kp->arg = mode;
+	mutex_unlock(&ppe_mode_mutex);
+	return err;
+}
+
+static bool airoha_ppe_mode_latch(void)
+{
+	bool mode;
+
+	mutex_lock(&ppe_mode_mutex);
+	ppe_mode_locked = true;
+	mode = ppe_mode1_probe;
+	mutex_unlock(&ppe_mode_mutex);
+	return mode;
+}
+
+static const struct kernel_param_ops ppe_mode_ops = {
+	.set = airoha_ppe_mode_set,
+	.get = param_get_bool,
+};
+module_param_cb(ppe_mode1_probe, &ppe_mode_ops, &ppe_mode1_probe, 0600);
+MODULE_PARM_DESC(ppe_mode1_probe,
+                "EN7581/MT7996 diagnostic firmware mode1; binding capability unchanged");
+
+#define PPE_TYPE_MODE1_PROBE	1
 #define PPE_TYPE_L2B_IPV4	2
 #define PPE_TYPE_L2B_IPV4_IPV6	3
 
