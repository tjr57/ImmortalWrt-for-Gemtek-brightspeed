#!/bin/sh /etc/rc.common
# Reconcile owner-published PPE bridge templates against the desired list.

START=99
USE_PROCD=1

start_service() {
	local enabled interval desired

	config_load xr_ppe_l2
	config_get_bool enabled main enabled 0
	config_get interval main interval 10
	config_get desired main desired /etc/xr-ppe-l2.desired
	[ "$enabled" = 1 ] || return 0
	case "$interval" in
	''|*[!0-9]*) interval=10 ;;
	esac
	[ "$interval" -ge 2 ] || interval=2

	procd_open_instance
	procd_set_param command /bin/sh -c \
		"while :; do /usr/sbin/xr-ppe-l2 reconcile '$desired' 5 | logger -t xr-ppe-l2; sleep $interval; done"
	procd_set_param respawn
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger xr_ppe_l2
}
