CONFIG_TARGET_airoha=y
CONFIG_TARGET_airoha_an7581=y
CONFIG_TARGET_airoha_an7581_DEVICE_gemtek_xr1710g=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_INITRAMFS_COMPRESSION_NONE=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_PREINIT_IP="192.168.10.3"
CONFIG_TARGET_PREINIT_NETMASK="255.255.255.0"
CONFIG_TARGET_PREINIT_BROADCAST="192.168.10.255"
CONFIG_DEVEL=y
CONFIG_CCACHE=y
CONFIG_CCACHE_DIR="/home/xrdev/.cache/ccache"
CONFIG_DOWNLOAD_FOLDER="/home/xrdev/downloads/openwrt"
CONFIG_PACKAGE_xr1710g-ap-defaults=y
CONFIG_PACKAGE_airoha-an7581-mt7996-board=y
CONFIG_PACKAGE_airoha-en7581-mt7996-npu-firmware=y
CONFIG_PACKAGE_kmod-mt7996e=y
CONFIG_PACKAGE_kmod-mt7996-firmware=y
CONFIG_PACKAGE_kmod-nf-conntrack-bridge=y
CONFIG_PACKAGE_kmod-nft-bridge=y
CONFIG_PACKAGE_kmod-hwmon-nct7802=y
CONFIG_PACKAGE_fitblk=y
CONFIG_PACKAGE_uboot-envtools=y
CONFIG_PACKAGE_wpad-mesh-mbedtls=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
# CONFIG_PACKAGE_luci-app-airoha-npu is not set
CONFIG_PACKAGE_luci-app-airoha-fancontrol=y
CONFIG_PACKAGE_luci-app-airoha-recovery=y
CONFIG_PACKAGE_iw-full=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_ethtool-full=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_lrzsz=y
CONFIG_PACKAGE_nand-utils=y

# WLAN NPU attachment and PPE forwarding default off; diagnostics remain compiled.
# CONFIG_KERNEL_NET_AIROHA_PPE_BIND_DEFAULT is not set
CONFIG_IMAGEOPT=y
CONFIG_PREINITOPT=y
CONFIG_TARGET_DEFAULT_LAN_IP_FROM_PREINIT=y
CONFIG_PACKAGE_xr1710g-ap-configurator=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_pciutils=y
CONFIG_PACKAGE_ip-bridge=y
CONFIG_PACKAGE_kmod-veth=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
# CONFIG_PACKAGE_luci-i18n-airoha-npu-zh-cn is not set
CONFIG_PACKAGE_luci-i18n-airoha-fancontrol-zh-cn=y
CONFIG_PACKAGE_luci-i18n-airoha-recovery-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y
CONFIG_PACKAGE_usteer=y
CONFIG_PACKAGE_xr1710g-ap-features=y

CONFIG_PACKAGE_xr1710g-ft-proxy=y

CONFIG_VERSION_NUMBER="20261017-ap49-d331711d"

CONFIG_VERSION_CODE="20261017-ap49-d331711d"
CONFIG_PACKAGE_kmod-netconsole=y
CONFIG_PACKAGE_xr1710g-kmsg-capture=y
CONFIG_PACKAGE_tc-tiny=y
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-sched-flower=y
CONFIG_PACKAGE_kmod-sched-act-vlan=y
# CONFIG_PACKAGE_xr-ppe-l2 is not set

# CONFIG_KERNEL_PERF_EVENTS is not set
CONFIG_VERSIONOPT=y
