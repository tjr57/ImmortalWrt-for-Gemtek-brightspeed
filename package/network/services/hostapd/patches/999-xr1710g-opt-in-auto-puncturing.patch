 		nl80211_vendor_event_qca(bss, subcmd, data, len);
 		break;
--- a/src/ap/drv_callbacks.c
+++ b/src/ap/drv_callbacks.c
@@ -2621,6 +2621,44 @@
 #endif /* CONFIG_IEEE80211BE */
 
 
+#if defined(CONFIG_IEEE80211BE) && defined(NEED_AP_MLME)
+static void hostapd_xr_pp_update(struct hostapd_data *hapd, __typeof__(((union wpa_event_data *)0)->ch_switch) *sw)
+{
+	struct hostapd_iface *iface;
+	struct hostapd_hw_modes *mode;
+	struct csa_settings settings;
+	int freq, ret;
+	unsigned i;
+	if (!hapd)
+		return;
+	iface = hapd->iface;mode = iface->current_mode;
+	if (!mode || !iface->conf->xr_pp_mode || hostapd_csa_in_progress(iface) ||
+	    !hw_get_channel_chan(mode, iface->conf->channel, &freq) || freq != sw->freq ||
+	    iface->conf->punct_bitmap == sw->punct_bitmap)
+		return;
+	os_memset(&settings, 0, sizeof(settings));
+	settings.cs_count = 5;settings.link_id = sw->link_id;
+	ret = hostapd_set_freq_params(&settings.freq_params, iface->conf->hw_mode,
+		freq, iface->conf->channel, iface->conf->enable_edmg, iface->conf->edmg_channel,
+		iface->conf->ieee80211n, iface->conf->ieee80211ac, iface->conf->ieee80211ax,
+		iface->conf->ieee80211be, iface->conf->secondary_channel,
+		hostapd_get_oper_chwidth(iface->conf), hostapd_get_oper_centr_freq_seg0_idx(iface->conf),
+		hostapd_get_oper_centr_freq_seg1_idx(iface->conf), mode->vht_capab,
+		&mode->he_capab[IEEE80211_MODE_AP], &mode->eht_capab[IEEE80211_MODE_AP], sw->punct_bitmap);
+	if (ret)
+		goto fail;
+	for (i = 0; i < iface->num_bss; i++) {
+		ret = hostapd_switch_channel(iface->bss[i], &settings);
+		if (ret)
+			goto fail;
+	}
+	return;
+fail:
+	wpa_printf(MSG_ERROR, "XR PP automatic bitmap CSA rejected: %d", ret);
+	hostapd_disable_iface(iface);
+}
+#endif
