+
+/* AP39 hardware evidence: an IPv4 bridge subflow remains BND when the
+ * same five-tuple changes DSCP/ECN, and rewrites every packet to IB2_DSCP.
+ * Copying the triggering DS byte, or rejecting only ECN triggers, cannot
+ * preserve later packets (including CE). Native L2B/IPv6 preservation has
+ * not been qualified either. No currently supported bridge format has a
+ * proven per-packet preserve or complete-DS-field match/trap mechanism.
+ * Keep the control-plane templates inert until such a mechanism is added
+ * and verified. This is a driver capability, not a writable policy bypass.
+ */
+static bool airoha_ppe_l2_dsfield_preserved(void)
+{
+	return false;
+}
 
