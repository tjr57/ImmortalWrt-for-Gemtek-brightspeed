+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef _LINUX_NETDEV_FWD_POLICY_H
+#define _LINUX_NETDEV_FWD_POLICY_H
+
+#include <linux/cleanup.h>
+#include <linux/types.h>
+
+/* Synchronous forwarding mutation fence shared by netdevice core and bridge.
+ * A writer scope covers the whole change, including pre-change notifiers,
+ * rejection, rollback and the post-change notification. Callbacks are atomic
+ * and must not acquire RTNL, bridge locks, sleep, or stop propagation.
+ * BEGIN has drained dependent caches before the writer may mutate; END makes
+ * the completed (or rolled back) change visible. Nested/concurrent writers
+ * remain fenced. INIT is delivered while registration is serialized with
+ * BEGIN/END, including writers already in progress. Receivers must mirror the
+ * absolute count. The fence is never held across the mutation, so a scope may
+ * sleep; it must only be entered from process or softirq context.
+ */
+enum netdev_fwd_policy_event {
+	NETDEV_FWD_POLICY_INIT,
+	NETDEV_FWD_POLICY_BEGIN,
+	NETDEV_FWD_POLICY_END,
+};
+
+struct netdev_fwd_policy_state {
+	u32 writers;
+};
+
+struct notifier_block;
+
+int netdev_fwd_policy_register(struct notifier_block *nb);
+void netdev_fwd_policy_unregister(struct notifier_block *nb);
+void netdev_fwd_policy_begin(void);
+void netdev_fwd_policy_end(void);
+
+DEFINE_LOCK_GUARD_0(netdev_fwd_change, netdev_fwd_policy_begin(),
+		    netdev_fwd_policy_end())
+
+#endif /* _LINUX_NETDEV_FWD_POLICY_H */
