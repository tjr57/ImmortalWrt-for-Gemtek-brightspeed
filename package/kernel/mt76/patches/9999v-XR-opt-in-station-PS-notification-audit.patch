+/* Read-only per-link WCID/PS mapping; no hardware register access. */
+static void mt7996_xr_ps_sta_read(void *data, struct ieee80211_sta *sta)
+{
+ struct mt7996_sta *msta = (struct mt7996_sta *)sta->drv_priv;
+ struct mt7996_vif *mvif = msta->vif;
+ struct ieee80211_vif *vif = container_of((void *)mvif, struct ieee80211_vif, drv_priv);
+ struct ieee80211_link_sta *link_sta;
+ struct seq_file *s = data;
+ unsigned int link_id;
+
+ rcu_read_lock();
+ for_each_sta_active_link(vif, sta, link_sta, link_id) {
+  struct mt7996_sta_link *link = mt7996_sta_link(msta, link_id);
+  if (!link)
+   continue;
+  seq_printf(s, "mac=%pM link=%u wcid=%u phy=%u ps=%u\n", sta->addr,
+             link_id, link->wcid.idx, link->wcid.phy_idx,
+             test_bit(MT_WCID_FLAG_PS, &link->wcid.flags));
+ }
+ rcu_read_unlock();
+}
+
+static int mt7996_xr_ps_state_read(struct seq_file *s, void *data)
+{
+ struct mt7996_dev *dev = dev_get_drvdata(s->private);
+ seq_puts(s, "schema=1 snapshot=approximate\n");
+ ieee80211_iterate_stations_atomic(mt76_hw(dev), mt7996_xr_ps_sta_read, s);
+ return 0;
+}
